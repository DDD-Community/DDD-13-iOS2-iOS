default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "600"

APP_NAME        = "Bangawo"
WORKSPACE       = "#{APP_NAME}.xcworkspace"
BUNDLE_ID       = ENV["APP_IDENTIFIER"] || "com.ddd-ios2.Bangawo"
TEAM_ID         = ENV["TEAM_ID"]
OUTPUT_DIR      = "./fastlane/output"
IPA_FILENAME    = "#{APP_NAME}.ipa"
METADATA_DIR    = "./fastlane/metadata"
SCREENSHOTS_DIR = "./fastlane/screenshots"

# 심사 담당자 연락처는 개인정보라 metadata 파일로 커밋하지 않고 환경변수로만 다룬다
REVIEW_CONTACT_ENV_KEYS = %w[
  APP_REVIEW_FIRST_NAME
  APP_REVIEW_LAST_NAME
  APP_REVIEW_PHONE_NUMBER
  APP_REVIEW_EMAIL
].freeze
MATCH_GIT_URL   = "https://github.com/Roy-wonji/FastlaneMatch.git"

platform :ios do

  # ──────────────────────────────────────────────────────────
  # Match
  # ──────────────────────────────────────────────────────────

  desc "개발용 인증서 로컬 설치 (readonly)"
  lane :match_development do
    match(
      type:         "development",
      readonly:     true,
      git_url:      MATCH_GIT_URL,
      storage_mode: "git",
      app_identifier: [BUNDLE_ID]
    )
  end

  desc "배포용 인증서 로컬 설치 (readonly)"
  lane :match_appstore do
    match(
      type:         "appstore",
      readonly:     true,
      git_url:      MATCH_GIT_URL,
      storage_mode: "git",
      app_identifier: [BUNDLE_ID]
    )
  end

  # ──────────────────────────────────────────────────────────
  # Beta (TestFlight)
  # ──────────────────────────────────────────────────────────

  desc "Bangawo-Prod → TestFlight 업로드"
  lane :beta do
    app_store_connect_api_key(
      key_id:                ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:             ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content:           ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house:              false
    )

    match(
      type:        "appstore",
      readonly:    true,
      git_url:     MATCH_GIT_URL,
      storage_mode: "git",
      app_identifier: [BUNDLE_ID]
    )

    ensure_workspace

    # 코드의 MARKETING_VERSION 기준으로 TestFlight 최신 빌드 넘버 +1 계산
    # (해당 버전이 없으면 initial_build_number(0) + 1 = 1)
    version = get_version_number(
      xcodeproj:     "Projects/App/#{APP_NAME}.xcodeproj",
      target:        APP_NAME,
      configuration: "Prod"
    )

    build_number = latest_testflight_build_number(
      app_identifier:       BUNDLE_ID,
      version:              version,
      initial_build_number: 0
    ) + 1

    UI.message("📦 #{version} 버전 빌드 넘버: #{build_number}")

    increment_build_number(
      xcodeproj:    "Projects/App/#{APP_NAME}.xcodeproj",
      build_number: build_number
    )

    build_app(
      workspace:        WORKSPACE,
      scheme:           "#{APP_NAME}-Prod",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: OUTPUT_DIR,
      output_name:      IPA_FILENAME,
      clean:            true,
      silent:           true,
      xcargs:           xcargs_flags,
      export_options:   export_options_hash
    )

    upload_to_testflight(
      ipa:                              "#{OUTPUT_DIR}/#{IPA_FILENAME}",
      skip_waiting_for_build_processing: true,
      notify_external_testers:          false,
      uses_non_exempt_encryption:       false
    )
  end

  # ──────────────────────────────────────────────────────────
  # Release (App Store)
  # ──────────────────────────────────────────────────────────

  desc "TestFlight 검증 빌드를 App Store 심사 제출 + 자동 출시"
  lane :release do |options|
    version = options[:version]
    UI.user_error!("version 옵션을 지정해주세요. 예: fastlane release version:1.0.0") unless version
    UI.user_error!("version 형식이 올바르지 않습니다: #{version} (예: 1.0.0)") unless version =~ /\A\d+\.\d+(\.\d+)?\z/

    # 미기입 메타데이터가 그대로 심사에 올라가지 않도록 제출 전에 차단한다
    verify_metadata

    app_store_connect_api_key(
      key_id:                ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:             ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content:           ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house:              false
    )

    # 새로 아카이브하지 않고, TestFlight 에서 검증 끝난 RC 빌드를 그대로 제출한다.
    # version 에 해당하는 TestFlight 최신 빌드를 선택한다 (없으면 검증 안 된 채 올라가므로 즉시 실패).
    build_number = latest_testflight_build_number(
      app_identifier:       BUNDLE_ID,
      version:              version,
      initial_build_number: -1
    )

    if build_number < 0
      UI.user_error!("#{version} 버전 빌드가 TestFlight 에 없습니다. 먼저 `fastlane beta` 로 RC 를 올려 검증하세요.")
    end

    UI.message("📦 심사 제출 대상: #{version} (#{build_number})")

    upload_to_app_store(
      app_version:                    version,
      build_number:                   build_number.to_s,
      # 새 아카이브 대신 위에서 고른 기존 TestFlight 빌드를 선택한다
      skip_binary_upload:             true,
      skip_metadata:                  false,
      metadata_path:                  METADATA_DIR,
      skip_screenshots:               false,
      screenshots_path:               SCREENSHOTS_DIR,
      overwrite_screenshots:          true,
      force:                          true,
      submit_for_review:              true,
      automatic_release:              true,
      precheck_include_in_app_purchases: false,
      reject_if_possible:             true,
      # 심사 담당자 연락처는 개인정보라 저장소에 두지 않고 ENV 로 주입한다
      # (notes 는 여기 없는 키이므로 review_information/notes.txt 에서 자동 로드된다)
      app_review_information:         app_review_contact,
      # 심사 제출 시 나오는 수출 규정·IDFA 질문에 대한 답변. 없으면 제출 단계에서 멈춘다
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false
      }
    )

    UI.success("🎉 #{version} (#{build_number}) 심사 제출 완료! (승인 시 자동 출시)")
  end

  desc "메타데이터 미기입/누락 검증 (배포 전 사전 점검)"
  lane :verify_metadata do
    Dir.chdir("..") do
      required_files = [
        "fastlane/metadata/copyright.txt",
        "fastlane/metadata/primary_category.txt",
        "fastlane/metadata/ko/name.txt",
        "fastlane/metadata/ko/description.txt",
        "fastlane/metadata/ko/keywords.txt",
        "fastlane/metadata/ko/release_notes.txt",
        "fastlane/metadata/ko/support_url.txt",
        "fastlane/metadata/ko/privacy_url.txt",
        "fastlane/metadata/review_information/notes.txt"
      ]

      missing = required_files.reject { |path| File.exist?(path) && !File.read(path).strip.empty? }
      UI.user_error!("메타데이터 파일이 비어있거나 없습니다:\n- #{missing.join("\n- ")}") unless missing.empty?

      unfilled = required_files.select { |path| File.read(path).include?("TODO_") }
      UI.user_error!("메타데이터에 TODO_ 자리표시자가 남아있습니다:\n- #{unfilled.join("\n- ")}") unless unfilled.empty?

      # App Store Connect 의 글자 수 제한. 초과분은 업로드 단계에서야 실패하므로 미리 잡는다
      { "fastlane/metadata/ko/name.txt" => 30,
        "fastlane/metadata/ko/subtitle.txt" => 30,
        "fastlane/metadata/ko/keywords.txt" => 100,
        "fastlane/metadata/ko/promotional_text.txt" => 170,
        "fastlane/metadata/ko/description.txt" => 4000,
        "fastlane/metadata/ko/release_notes.txt" => 4000 }.each do |path, limit|
        next unless File.exist?(path)

        length = File.read(path).strip.length
        UI.user_error!("#{path} 가 #{limit}자 제한을 초과했습니다 (현재 #{length}자)") if length > limit
      end

      screenshots = Dir.glob("fastlane/screenshots/ko/*.{png,jpg,jpeg}")
      UI.user_error!("fastlane/screenshots/ko 에 스크린샷이 없습니다") if screenshots.empty?

      # 심사 담당자 연락처는 파일이 아니라 ENV(로컬은 fastlane/.env, CI 는 Secrets)에서 온다
      missing_env = REVIEW_CONTACT_ENV_KEYS.reject { |key| ENV[key].to_s.strip.length > 0 }
      unless missing_env.empty?
        UI.user_error!(
          "심사 담당자 연락처 환경변수가 비어있습니다:\n- #{missing_env.join("\n- ")}\n" \
          "로컬은 fastlane/.env, CI 는 GitHub Secrets 에 설정하세요."
        )
      end

      UI.success("✅ 메타데이터 검증 통과 (스크린샷 #{screenshots.count}장)")
    end
  end

end

# ──────────────────────────────────────────────────────────
# Private helpers
# ──────────────────────────────────────────────────────────

private_lane :ensure_workspace do
  Dir.chdir("..") do
    next unless Dir.glob("*.xcworkspace").empty?

    UI.message("워크스페이스가 없어 tuist generate를 실행합니다...")
    sh("./tuisttool generate")
    UI.user_error!("워크스페이스 생성 실패") if Dir.glob("*.xcworkspace").empty?
  end
end

def xcargs_flags
  "CODE_SIGN_IDENTITY='Apple Distribution' " \
  "CODE_SIGN_STYLE=Manual " \
  "DEVELOPMENT_TEAM=#{TEAM_ID} " \
  "COMPILER_INDEX_STORE_ENABLE=NO " \
  "ENABLE_BITCODE=NO " \
  "-allowProvisioningUpdates"
end

def app_review_contact
  {
    first_name:    ENV["APP_REVIEW_FIRST_NAME"],
    last_name:     ENV["APP_REVIEW_LAST_NAME"],
    phone_number:  ENV["APP_REVIEW_PHONE_NUMBER"],
    email_address: ENV["APP_REVIEW_EMAIL"]
  }
end

def export_options_hash
  {
    signingStyle:         "manual",
    uploadBitcode:        false,
    teamID:               TEAM_ID,
    provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" }
  }
end
